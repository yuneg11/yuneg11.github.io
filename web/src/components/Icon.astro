}

// Icons drawn on a canvas other than 24x24.
const viewBoxes: Record<string, string> = { arxiv: '0 0 448 512' }

const body = stroke[name] ?? fill[name]
if (!body) throw new Error(`Unknown icon: ${name}`)
const isStroke = name in stroke
---
<svg
  class={cls}
  viewBox={viewBoxes[name] ?? '0 0 24 24'}
  aria-hidden="true"
  fill={isStroke ? 'none' : 'currentColor'}
  stroke={isStroke ? 'currentColor' : 'none'}
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  set:html={body}
/>
