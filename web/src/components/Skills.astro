---
import { data, loc, onWeb, type Lang } from '../lib/data'
import { t } from '../lib/i18n'

interface Props { lang: Lang }
const { lang } = Astro.props
const s = t(lang)
const groups = onWeb(data.skills)
---
<section id="skills" class="section">
  <div class="container">
    <div class="section-head reveal">
      <h2 class="section-title">{s.skills}</h2>
    </div>
    <div class="groups">
      {groups.map((g) => (
        <div class="group reveal">
          <h3>{loc(g.category, lang)}</h3>
          <ul>
            {g.items.map((i) => <li class="chip">{loc(i, lang)}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .group {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 8px 16px;
    padding: 14px 0;
    border-top: 1px solid var(--border);
  }

  h3 {
    padding-top: 4px;
    color: var(--text-3);
    font-size: 13px;
    font-weight: 500;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .chip {
    height: 26px;
    padding: 0 10px;
    background: var(--bg);
    color: var(--text);
    font-size: 13px;
  }

  @media (max-width: 560px) {
    .group {
      grid-template-columns: 1fr;
    }

    h3 {
      padding-top: 0;
    }
  }
</style>
