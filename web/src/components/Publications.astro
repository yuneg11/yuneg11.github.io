---
import Icon from './Icon.astro'
import { data, loc, onWeb, authors, pubLinks, type Lang, type Publication } from '../lib/data'
import { t } from '../lib/i18n'

interface Props { lang: Lang }
const { lang } = Astro.props
const s = t(lang)

const pubs = onWeb(data.publications)
const TYPES = ['conference', 'workshop', 'journal', 'preprint'] as const
const groups = TYPES.map((type) => ({ type, list: pubs.filter((p) => p.type === type) })).filter((g) => g.list.length)
const yearsOf = (list: Publication[]) => [...new Set(list.map((p) => p.year))].sort((a, b) => b - a)
---
<section id="publications" class="section">
  <div class="container">
    <div class="section-head reveal">
      <h2 class="section-title">{s.publications}<span class="section-count mono">{pubs.length}</span></h2>
    </div>

    {groups.map((g) => (
      <div class="type-group">
        <h3 class="type-head reveal">{s[g.type]}<span class="mono">{g.list.length}</span></h3>
        {yearsOf(g.list).map((y) => (
          <div class="year-group">
            <div class="year mono">{y}</div>
            <div>
              {g.list.filter((p) => p.year === y).map((p) => {
                const note = loc(p.note, lang)
                const links = pubLinks(p)
                return (
                  <article class={`pub reveal${p.image ? ' has-image' : ''}`}>
                    <div class="body">
                      <h4>
                        {links.title ? <a class="link" href={links.title} target="_blank" rel="noopener">{p.title}</a> : p.title}
                      </h4>
                      <p class="authors">
                        {authors(p).map((a, i, all) => (
                          <>
                            {a.me ? (
                              <strong>{a.name}</strong>
                            ) : a.url ? (
                              <a class="link" href={a.url} target="_blank" rel="noopener">{a.name}</a>
                            ) : (
                              <span>{a.name}</span>
                            )}
                            {a.equal && <sup>*</sup>}
                            {i < all.length - 1 && ', '}
                          </>
                        ))}
                      </p>
                      {p.equal?.length ? <p class="equal-note"><sup>*</sup>{s.equal}</p> : null}
                      <div class="foot">
                        <span class="venue mono">{p.venue}</span>
                        {note && <span class="badge">{note}</span>}
                        <span class="links">
                          {links.paper && (
                            <a href={links.paper} target="_blank" rel="noopener"><Icon name="paper" /><span>{s.paper}</span></a>
                          )}
                          {links.arxiv && (
                            <a href={links.arxiv} target="_blank" rel="noopener"><Icon name="arxiv" /><span>{s.arxiv}</span></a>
                          )}
                          {links.code && (
                            <a href={links.code} target="_blank" rel="noopener"><Icon name="github" /><span>{s.code}</span></a>
                          )}
                          {p.bibtex && (
                            <button
                              type="button"
                              data-bibtex={p.bibtex.trim()}
                              data-label={s.bibtex}
                              data-copied={s.copied}
                            >
                              <Icon name="braces" class="i-copy" /><Icon name="check" class="i-check" /><span>{s.bibtex}</span>
                            </button>
                          )}
                        </span>
                      </div>
                    </div>
                    {p.image && (
                      <div class="thumb">
                        <img src={p.image} alt="" loading="lazy" decoding="async" />
                      </div>
                    )}
                  </article>
                )
              })}
            </div>
          </div>
        ))}
      </div>
    ))}
  </div>
</section>

<style>
  .type-group + .type-group {
    margin-top: 32px;
  }

  /* Quiet group label; the first year rule below it does the separating. */
  .type-head {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding-bottom: 10px;
    color: var(--text-3);
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  :global(:root[lang='ko']) .type-head {
    font-size: 12.5px;
    letter-spacing: 0.02em;
  }

  .type-head span {
    font-weight: 400;
    letter-spacing: 0;
  }

  .year-group {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr);
    gap: 16px;
    border-top: 1px solid var(--border);
  }

  /* Same gray as the group label, aligned to the first title line. */
  .year {
    position: sticky;
    top: 72px;
    align-self: start;
    padding-top: 15px;
    padding-bottom: 14px; /* stops level with the last row's footer, not the rule below it */
    color: var(--text-3);
    font-size: 13px;
  }

  .pub {
    padding: 14px 0;
  }

  .pub + .pub {
    border-top: 1px solid var(--border);
  }

  /* Figure on the right so titles line up whether or not a paper has one. */
  .pub.has-image {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 150px;
    gap: 24px;
    align-items: start;
  }

  .thumb {
    aspect-ratio: 16 / 10;
    border-radius: 4px;
    background: #fff; /* paper figures are drawn on white */
    overflow: hidden;
  }

  :global([data-scheme='dark']) .thumb {
    filter: brightness(0.9);
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .body {
    min-width: 0;
  }

  h4 {
    margin: 0;
    font-size: 15.5px;
    font-weight: 600;
    line-height: 1.45;
    letter-spacing: -0.012em;
  }

  .authors {
    margin-top: 5px;
    color: var(--text-2);
    font-size: 13.5px;
    line-height: 1.55;
  }

  .authors strong {
    color: var(--mark-me);
    font-weight: 600;
  }

  .authors a:hover {
    color: var(--text);
  }

  .authors sup,
  .equal-note sup {
    margin-left: 1px;
    font-size: 0.75em;
  }

  .equal-note {
    margin-top: 1px;
    color: var(--text-3);
    font-size: 12.5px;
  }

  .equal-note sup {
    margin: 0 3px 0 0;
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
    margin-top: 8px;
  }

  .venue {
    color: var(--text);
    font-size: 12px;
    font-weight: 600;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    height: 20px;
    padding: 0 7px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    color: var(--text);
    font-size: 11px;
    font-weight: 500;
    line-height: 1;
    white-space: nowrap;
  }

  .links {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 2px 14px;
  }

  .links a,
  .links button {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--text-2);
    font-size: 13px;
    cursor: pointer;
    transition: color 0.2s var(--ease);
  }

  .links a:hover,
  .links button:hover {
    color: var(--text);
  }

  /* The shared growing underline (.link), drawn under the label only. */
  .links span {
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: background-size 0.3s var(--ease);
  }

  .links a:hover span,
  .links button:hover span {
    background-size: 100% 1px;
  }

  .links :global(svg) {
    width: 13px;
    height: 13px;
    color: var(--text-3);
    transition: color 0.2s var(--ease);
  }

  .links a:hover :global(svg),
  .links button:hover :global(svg) {
    color: var(--text);
  }

  .links :global(.i-check),
  .links :global(.done .i-copy) {
    display: none;
  }

  .links :global(.done .i-check) {
    display: block;
  }

  @media (max-width: 760px) {
    .year-group {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .year {
      position: static;
      padding-top: 14px;
    }

    .pub:first-child {
      padding-top: 8px;
    }
  }

  @media (max-width: 560px) {
    .pub.has-image {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .thumb {
      order: -1;
      max-width: 320px;
    }
  }
</style>
