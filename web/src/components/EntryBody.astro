---
// One renderer for every entry (experiences, education, projects, awards).
import { loc, onWeb, refOrText, entryLocation, formatPeriod, isOngoing, inline, type Entry, type Lang } from '../lib/data'
import { t } from '../lib/i18n'

interface Props { entry: Entry; lang: Lang; showLocation?: boolean }
const { entry: e, lang, showLocation = true } = Astro.props
const s = t(lang)

const title = loc(e.title, lang)
const url = loc(e.url, lang)
const org = refOrText(e.org, lang)
const unit = refOrText(e.unit, lang)
const period = formatPeriod(e, lang, s.present)
const place = showLocation ? entryLocation(e, lang) : undefined
const details = onWeb(e.details).map((d) => inline(loc(d.text, lang), lang))
const ongoing = isOngoing(e)
---
<div class="entry">
  <div class="head">
    <div class="what">
      <h3>
        {url ? <a class="link" href={url} target="_blank" rel="noopener">{title}</a> : title}
        {ongoing && <span class="chip now">{s.present}</span>}
      </h3>
      {[org, unit].filter((o) => o).map((o) => (
        <p class="org">
          {o!.url ? <a class="link" href={o!.url} target="_blank" rel="noopener">{o!.text}</a> : o!.text}
        </p>
      ))}
    </div>
    {(period || place) && (
      <div class="when">
        {period && <span class="mono">{period}</span>}
        {place && <span class="place">{place}</span>}
      </div>
    )}
  </div>
  {details.length === 1 && <p class="detail prose" set:html={details[0]} />}
  {details.length > 1 && (
    <ul class="details prose">
      {details.map((d) => <li set:html={d} />)}
    </ul>
  )}
</div>

<style>
  .head {
    display: flex;
    justify-content: space-between;
    gap: 6px 20px;
    flex-wrap: wrap;
  }

  .what {
    min-width: 0;
    flex: 1 1 320px;
  }

  h3 {
    font-size: 16px;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.015em;
  }

  .now {
    height: 20px;
    margin-left: 8px;
    padding: 0 8px;
    font-size: 11px;
    vertical-align: 2px;
  }

  /* Organization and unit each get their own line. */
  .org {
    color: var(--text-2);
    font-size: 14.5px;
  }

  h3 + .org {
    margin-top: 2px;
  }

  .org a:hover {
    color: var(--text);
  }

  .when {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
    padding-top: 2px;
    color: var(--text-3);
    font-size: 12.5px;
    white-space: nowrap;
  }

  .detail {
    margin-top: 6px;
    color: var(--text-3);
    font-size: 14px;
  }

  .details {
    display: grid;
    gap: 4px;
    margin-top: 10px;
    color: var(--text-2);
    font-size: 14.5px;
  }

  .details li {
    position: relative;
    padding-left: 16px;
  }

  .details li::before {
    content: '';
    position: absolute;
    left: 3px;
    top: 0.78em;
    width: 5px;
    height: 1px;
    background: var(--text-3);
  }

  @media (max-width: 560px) {
    .when {
      flex-direction: row;
      align-items: center;
      gap: 10px;
    }

    .when .place::before {
      content: '·';
      margin-right: 10px;
    }
  }
</style>
